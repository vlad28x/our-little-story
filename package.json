{
  "name": "five-meetings",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/engine.test.ts tests/save.test.ts tests/chapterAccess.test.ts tests/telegram.test.ts tests/constellation.test.ts tests/kitchen.test.ts tests/eveningRoute.test.ts tests/content.test.ts tests/supper-art.test.tsx tests/polish23.test.ts",
    "validate:content": "vitest run tests/content.test.ts",
    "test:smoke": "playwright test smoke.spec.ts",
    "test:offline": "playwright test --config=playwright.offline.config.ts",
    "test:dev": "playwright test --config=playwright.dev.config.ts",
    "lint": "eslint src tests",
    "test:e2e": "playwright test",
    "test:all": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
